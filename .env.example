# Supabase: copy the Session Pooler / compatible Postgres connection string from Connect.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# OpenAI is required for real semantic embeddings and optional LLM routing.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-4o-mini
